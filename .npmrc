# El stack de account abstraction de Privy (viem + permissionless + ox) tiene
# rangos de peer deps que chocan entre si (viem quiere ox@0.14, permissionless
# pide ox@^0.8). Es un conflicto interno del arbol de Privy, no de nuestro codigo.
# legacy-peer-deps deja que npm instale sin bloquearse por esos peers.
legacy-peer-deps=true
