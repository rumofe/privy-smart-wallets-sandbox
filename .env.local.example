# Copia este fichero a .env.local y rellena con tus valores reales.
# .env.local NO se commitea (esta en .gitignore).

# App ID de Privy (publico, del dashboard.privy.io). Obligatorio.
NEXT_PUBLIC_PRIVY_APP_ID=

# App Secret de Privy (SECRETO, del dashboard -> Settings -> API keys).
# SIN prefijo NEXT_PUBLIC: solo lo lee el backend (API route), nunca el navegador.
PRIVY_APP_SECRET=

# --- Session signer / authorization key (modelo TEE) ---
# En el dashboard de Privy creas una "authorization key" y obtienes:
#   - un ID  -> va aqui (publico, lo usa el front para anadir el signer)
NEXT_PUBLIC_PRIVY_SIGNER_ID=
#   - una private key (base64 PKCS8, sin cabeceras PEM) -> va aqui (SECRETA, backend)
PRIVY_AUTHORIZATION_KEY=

# --- Opcionales: solo para el boton "batch approve + deposit" (patron Morpho) ---
# Direcciones de los mocks desplegados en Base Sepolia (ver contracts/README.md).
NEXT_PUBLIC_TEST_TOKEN=
NEXT_PUBLIC_TEST_VAULT=

# --- Opcional: policy para acotar el session signer (paso 3) ---
# ID de una policy creada en el dashboard (allowlist de contratos TOKEN+VAULT).
NEXT_PUBLIC_PRIVY_POLICY_ID=
